# Local path to an extract, and any pack copied into the project.
# The extract is not part of OpenCHQ.
local/
data/
# The exception: the baked board and the decoded font atlas are ours, small, and the only reason the
# public host can draw the original's world instead of a blank grid.
!web/data/
!web/data/*.json

# Export output
export/
*.tmp

.DS_Store

# Railway CLI link state
.railway/

# Windows junk from the reference extract
**/Thumbs.db

# Python bytecode from the RE harnesses
__pycache__/
*.pyc

# Soak runs write screenshots and a json per run. The T-007 AC6 run is committed as evidence;
# later runs stay on the machine.
tests/e2e/soak-*/
# Speed hand-check runs: screenshots + summary.json per run, same rule.
tests/e2e/t004-speed-handcheck-*/

# T-010 live-sweep runs: screenshots and a summary per run, evidence stays on the machine.
tests/e2e/t010-*/
# T-014 frame-time runs: a summary.json per run.
tests/e2e/t014-frame-time*/
# The e2e suite's own Playwright install (package.json is committed; the install is not).
tests/e2e/node_modules/
tests/e2e/package-lock.json
